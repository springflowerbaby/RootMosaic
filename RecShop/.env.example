# RecShop local business configuration: copy to .env and supply your own secrets.
# Hosts below are for local Python services; Kubernetes uses Service DNS.
# Model paths are optional overrides of repository-relative service defaults.
# SASREC_MODEL_PATH=/absolute/path/to/model.pth
# SASREC_CACHE_PATH=/absolute/path/to/standard_cache.pkl
# SASREC_ITEM_FILE=/absolute/path/to/electronics.item
# ITEM_FILE_PATH=/absolute/path/to/electronics.item
SASREC_HOST=0.0.0.0
SASREC_PORT=8200
RECOMMENDATION_HOST=0.0.0.0
RECOMMENDATION_PORT=5001
SASREC_API_URL=http://127.0.0.1:8200
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_API_BASE=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
SHOPWEB_HOST=0.0.0.0
SHOPWEB_PORT=3000
SHOPWEB_DEBUG=False
SECRET_KEY=dev-secret-key-change-in-production
